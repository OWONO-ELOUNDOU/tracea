# Application
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001

# Base de données
DATABASE_URL=postgres://tracea:tracea@localhost:5432/tracea

# File de tâches
REDIS_URL=redis://localhost:6379/0

# Stockage objet
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tracea-exports
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# Sessions et sécurité
SESSION_SECRET=
SESSION_TTL_HOURS=72
CSRF_SECRET=
RATE_LIMIT_PER_MINUTE=60

# E-mail
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Tracea <no-reply@tracea.app>

# Moteur Tracea
ENGINE_WORKERS=2
ENGINE_JOB_TIMEOUT_SECONDS=120
ENGINE_DEFAULT_SEED=
INTERPRETER_PROVIDER=rules
INTERPRETER_ENDPOINT=
INTERPRETER_API_KEY=

# Observabilité
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PORT=9464
