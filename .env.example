# Application
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
# URL de l'API vue depuis le navigateur (lue au build de l'application web)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Base de données
# La commande de purge quotidienne (pnpm --filter @tracea/api purge) ne lit que DATABASE_URL,
# obligatoire pour elle et sans valeur par défaut, et LOG_LEVEL : ne lui transmettez ni
# SESSION_SECRET ni les accès SMTP ou stockage. Elle supprime les sessions expirées, les projets
# en corbeille depuis plus de 30 jours et les jetons d'e-mail expirés ou utilisés depuis plus
# de 7 jours.
DATABASE_URL=postgres://tracea:tracea@localhost:5432/tracea

# File de tâches
REDIS_URL=redis://localhost:6379/0

# Stockage objet
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tracea-exports
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# Sessions et sécurité
# 32 caractères minimum ; générer avec : openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=72
CSRF_SECRET=
RATE_LIMIT_PER_MINUTE=60
# Mandataires inverses de confiance (répartiteur, contrôleur d'entrée) : adresses IP ou plages
# CIDR séparées par des virgules, ou loopback, linklocal, uniquelocal. Seuls ces mandataires
# peuvent fixer l'adresse du client par X-Forwarded-For, qui sert aux limites de débit.
# Vide en local, avec docker compose et en e2e (aucun mandataire). En staging et en production :
# plage exacte du répartiteur. Refusés au démarrage : true, *, 0.0.0.0/0, ::/0, un nombre ;
# false (et no, off, none) : laisser vide pour n'avoir aucun mandataire.
TRUST_PROXY=

# E-mail
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Tracea <no-reply@tracea.app>

# Moteur Tracea
ENGINE_WORKERS=2
ENGINE_JOB_TIMEOUT_SECONDS=120
ENGINE_DEFAULT_SEED=
INTERPRETER_PROVIDER=rules
INTERPRETER_ENDPOINT=
INTERPRETER_API_KEY=

# Observabilité
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PORT=9464
