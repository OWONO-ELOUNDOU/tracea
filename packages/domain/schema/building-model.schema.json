{
  "$id": "https://tracea.app/schemas/building-model/1.0",
  "title": "BuildingModel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "author": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": ["name", "revision"],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "boundary": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "northAngle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "setbacks": {
          "type": "object",
          "properties": {
            "front": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "side": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["front", "side", "rear"],
          "additionalProperties": false
        },
        "accessEdgeIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "slope": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "percent"],
          "additionalProperties": false
        },
        "groundLevel": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["boundary", "northAngle", "setbacks", "accessEdgeIndex", "slope", "groundLevel"],
      "additionalProperties": false
    },
    "levels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elevation": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "slabThickness": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "name", "index", "elevation", "height", "slabThickness"],
        "additionalProperties": false
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "levelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "start": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "end": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "thickness": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": ["exterior", "loadBearing", "partition"]
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "locked": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": ["id", "levelId", "start", "end", "thickness", "kind", "locked"],
        "additionalProperties": false
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "wallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "type": {
            "type": "string",
            "enum": ["door", "window", "frenchWindow", "garageDoor", "opening"]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sillHeight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "swing": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "side": {
                    "type": "string",
                    "enum": ["left", "right"]
                  },
                  "direction": {
                    "type": "string",
                    "enum": ["in", "out"]
                  }
                },
                "required": ["side", "direction"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "locked": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "wallId",
          "type",
          "offset",
          "width",
          "height",
          "sillHeight",
          "swing",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "levelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "living",
              "kitchen",
              "bedroom",
              "bathroom",
              "wc",
              "hall",
              "corridor",
              "office",
              "laundry",
              "storage",
              "garage",
              "technical"
            ]
          },
          "wallIds": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "polygon": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "area": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "habitable": {
            "type": "boolean"
          },
          "locked": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "levelId",
          "name",
          "type",
          "wallIds",
          "polygon",
          "area",
          "habitable",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "stairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fromLevelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "toLevelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "footprint": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "type": {
            "type": "string",
            "enum": ["straight", "quarterTurn", "halfTurn", "spiral"]
          },
          "upDirection": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          },
          "riserHeight": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "treadDepth": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "fromLevelId",
          "toLevelId",
          "footprint",
          "type",
          "upDirection",
          "riserHeight",
          "treadDepth"
        ],
        "additionalProperties": false
      }
    },
    "roof": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["flat", "gable", "hip", "shed"]
        },
        "pitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 89
        },
        "overhang": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ridgeDirection": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number",
                  "const": 0
                },
                {
                  "type": "number",
                  "const": 90
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": ["type", "pitch", "overhang", "ridgeDirection", "material"],
      "additionalProperties": false
    },
    "slabs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "levelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "polygon": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "thickness": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "levelId", "polygon", "thickness"],
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "levelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "kind": {
                "type": "string",
                "enum": ["exterior", "interior"]
              },
              "points": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "offset": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["id", "levelId", "kind", "points", "offset"],
            "additionalProperties": false
          }
        },
        "sectionLines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              },
              "start": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "end": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "lookDirection": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              }
            },
            "required": ["id", "name", "start", "end", "lookDirection"],
            "additionalProperties": false
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "levelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": ["id", "levelId", "position", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["dimensions", "sectionLines", "labels"],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "levelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["code", "severity", "message", "targetIds"],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "habitableArea": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "floorArea": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "footprintArea": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "siteCoverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["habitableArea", "floorArea", "footprintArea", "siteCoverageRatio"],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "programHash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["seed", "engineVersion", "programHash"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "project",
    "site",
    "levels",
    "walls",
    "openings",
    "rooms",
    "stairs",
    "roof",
    "slabs",
    "annotations",
    "checks",
    "metrics",
    "generation"
  ],
  "additionalProperties": false
}
