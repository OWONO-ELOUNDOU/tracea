{
  "name": "@tracea/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "purge": "node dist/maintenance/cli.js",
    "purge:dev": "tsx src/maintenance/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@tracea/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tracea/config": "workspace:*",
    "@types/node": "^22.17.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
